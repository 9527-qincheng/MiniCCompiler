{
  "name": "minic-gui",
  "version": "1.0.0",
  "description": "MiniC 编译器 GUI（Electron 前端 + minic.exe 后端）",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "vite --config renderer/vite.config.mjs",
    "build": "vite build --config renderer/vite.config.mjs",
    "start": "npm run build && electron . --no-sandbox --disable-gpu",
    "start:fast": "electron . --no-sandbox --disable-gpu",
    "shot": "electron . --no-sandbox --disable-gpu --shot",
    "test": "node test/compile-smoke.js",
    "test:book": "node test/book-smoke.js",
    "test:samples": "node test/sample-smoke.js",
    "test:run": "node test/run-smoke.js"
  },
  "author": "MiniC 实训小组",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^37.10.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "echarts": "^6.1.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
